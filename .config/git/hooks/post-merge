#!/bin/sh

# SPDX-FileCopyrightText: Copyright © 2026 Caleb Cushing
#
# SPDX-License-Identifier: MIT

# Skip in CI environments
[ -n "$CI" ] && exit 0

# Check if lockfiles changed in this merge (HEAD@{1} is the state before the merge)
PNPM_LOCK_CHANGED=0
UV_LOCK_CHANGED=0

if ! git diff --quiet HEAD@{1} HEAD -- pnpm-lock.yaml 2>/dev/null; then
  PNPM_LOCK_CHANGED=1
fi

if ! git diff --quiet HEAD@{1} HEAD -- uv.lock 2>/dev/null; then
  UV_LOCK_CHANGED=1
fi

if [ "$PNPM_LOCK_CHANGED" -eq 1 ]; then
  echo "pnpm-lock.yaml changed, running pnpm install --frozen-lockfile..."
  pnpm install --frozen-lockfile
fi

if [ "$UV_LOCK_CHANGED" -eq 1 ]; then
  echo "uv.lock changed, running uv sync --frozen..."
  uv sync --frozen
fi
